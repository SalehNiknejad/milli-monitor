{
    "name": "gold-price-monitor",
    "version": "1.0.0",
    "description": "Real-time gold price monitor with wallet calculator and alerts",
    "private": true,
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "server": "nodemon server/server.js",
        "start": "concurrently \"npm run server\" \"npm run dev\"",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "electron:dev": "concurrently \"npm:dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
        "electron:build": "npm run build && electron-builder"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "fs-extra": "^11.3.5",
        "jalaali-js": "^1.2.8",
        "lucide-react": "^0.263.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^7.15.1",
        "recharts": "^3.8.1",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@types/react": "^18.2.15",
        "@types/react-dom": "^18.2.7",
        "@vitejs/plugin-react": "^4.0.3",
        "autoprefixer": "^10.4.14",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^28.2.0",
        "electron-builder": "^24.6.0",
        "nodemon": "^3.1.14",
        "postcss": "^8.4.24",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.3.0",
        "typescript": "^5.0.2",
        "vite": "^4.4.5",
        "wait-on": "^7.0.1"
    },
    "build": {
        "productName": "Milli Gold Monitor",
        "appId": "com.milli.gold.monitor",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**",
            "electron/main.js",
            "public/**"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        }
    }
}
